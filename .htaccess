# Apache / LiteSpeed: canonical host and explicit permanent alias redirects.
<IfModule mod_rewrite.c>
RewriteEngine On
# Host-limited rules keep localhost and staging usable.
RewriteCond %{HTTP_HOST} ^www\.uslusurucukursu\.com$ [NC]
RewriteRule ^ https://uslusurucukursu.com%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^uslusurucukursu\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://uslusurucukursu.com%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^index/?$ / [R=301,L]
RewriteRule ^en/index/?$ /en/ [R=301,L]
RewriteRule ^site-haritasi/?$ /sitemap.xml [R=301,L]
RewriteRule ^en/site-map/?$ /sitemap.xml [R=301,L]
RewriteRule ^egitmenlerimiz/?$ /hakkimizda/ [R=301,L]
RewriteRule ^en/gallery/genel/?$ /en/gallery/general/ [R=301,L]
RewriteRule ^en/gallery/gcars/?$ /en/gallery/cars/ [R=301,L]
RewriteRule ^en/gallery/gclass/?$ /en/gallery/class/ [R=301,L]
RewriteRule ^en/train/ozel-ab/?$ /en/train/special-ab/ [R=301,L]
# Only explicit browser requests for index.html are redirected (not internal resolution).
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
ExpiresByType text/javascript "access plus 7 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(html|xml|txt)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>
ErrorDocument 404 /error/404/index.html
