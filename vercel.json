{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "crons": [
    {"path": "/api/haftalik-rapor/", "schedule": "0 6 * * 1"}
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {"source": "/:path*", "has": [{"type": "host", "value": "www.uslusurucukursu.com"}], "destination": "https://uslusurucukursu.com/:path*", "permanent": true},
    {"source": "/index/", "destination": "/", "permanent": true},
    {"source": "/en/index/", "destination": "/en/", "permanent": true},
    {"source": "/site-haritasi/", "destination": "/sitemap.xml", "permanent": true},
    {"source": "/en/site-map/", "destination": "/sitemap.xml", "permanent": true},
    {"source": "/egitmenlerimiz/", "destination": "/hakkimizda/", "permanent": true},
    {"source": "/en/gallery/genel/", "destination": "/en/gallery/general/", "permanent": true},
    {"source": "/en/gallery/gcars/", "destination": "/en/gallery/cars/", "permanent": true},
    {"source": "/en/gallery/gclass/", "destination": "/en/gallery/class/", "permanent": true},
    {"source": "/en/train/ozel-ab/", "destination": "/en/train/special-ab/", "permanent": true},
    {"source": "/blog", "destination": "/", "permanent": true},
    {"source": "/blog/", "destination": "/", "permanent": true},
    {"source": "/blog/(.*)", "destination": "/", "permanent": true},
    {"source": "/qr/fb/", "destination": "https://wa.me/905320685647?text=Merhabalar%2C%20web%20sitenizden%20s%C3%BCr%C3%BCc%C3%BC%20kursunuzu%20g%C3%B6rd%C3%BCm.%20Bilgi%20almak%20istiyorum%20yard%C4%B1mc%C4%B1%20olabilir%20misiniz%3F", "permanent": false},
    {"source": "/qr/in/", "destination": "https://wa.me/905320685647?text=Merhabalar%2C%20web%20sitenizden%20s%C3%BCr%C3%BCc%C3%BC%20kursunuzu%20g%C3%B6rd%C3%BCm.%20Bilgi%20almak%20istiyorum%20yard%C4%B1mc%C4%B1%20olabilir%20misiniz%3F", "permanent": false},
    {"source": "/qr/wp/", "destination": "https://wa.me/905320685647?text=Merhabalar%2C%20web%20sitenizden%20s%C3%BCr%C3%BCc%C3%BC%20kursunuzu%20g%C3%B6rd%C3%BCm.%20Bilgi%20almak%20istiyorum%20yard%C4%B1mc%C4%B1%20olabilir%20misiniz%3F", "permanent": false},
